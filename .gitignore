# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# 沙箱环境临时本地仓库（仅构建验证用）
.m2repo/

# IDE - IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# IDE - Eclipse
.settings/
.classpath
.project
.factorypath

# IDE - VS Code
.vscode/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/

# Local env / secrets
.env
*.local.yml

# 运行时数据目录（SQLite 数据库、封面缓存、密钥、日志）
data/

# 管理端产物（dashboard 的 `vite build --base=/admin/` 生成后拷进来，构建镜像前才需要；
# 产物有 100+ 个带哈希的文件，不进仓库，靠 README/操作手册 05 的命令复现）
bifrost-bootstrap/src/main/resources/static/admin/

# hurl 契约测试运行产物（样本音乐）
data-sample/

.codegraph
