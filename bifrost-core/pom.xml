<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bifrost</groupId>
        <artifactId>bifrost</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bifrost-core</artifactId>
    <name>bifrost-core</name>
    <description>核心业务逻辑（Service 层）：视频扫描、音频标签解析、电子书元数据解析</description>

    <dependencies>
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>bifrost-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>bifrost-domain</artifactId>
        </dependency>
        <!-- 基础 Spring 容器能力（@Service 等），不引入 Web / 持久层等重量级 Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 标签解析：jaudiotagger 3.0.1（ADR-0002：文档 2.0.3 不存在于 Maven Central） -->
        <dependency>
            <groupId>net.jthink</groupId>
            <artifactId>jaudiotagger</artifactId>
            <version>3.0.1</version>
        </dependency>
        <!-- 拼音索引：jpinyin（中文艺术家首字母分组） -->
        <dependency>
            <groupId>com.github.stuxuhai</groupId>
            <artifactId>jpinyin</artifactId>
            <version>1.1.8</version>
        </dependency>
        <!-- M2-book 电子书元数据解析（ADR-0004 物理隔开）
             显式排除 slf4j-simple：epublib-core 自带它，与 bifrost-bootstrap 的 logback 冲突 -->
        <dependency>
            <groupId>com.positiondev.epublib</groupId>
            <artifactId>epublib-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>xmpbox</artifactId>
        </dependency>
        <!-- Test scope：JUnit 5 + Mockito + AssertJ（spring-boot-starter-test 集成）
             显式排除 slf4j-simple，避免与 bifrost-bootstrap 的 logback 冲突 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
