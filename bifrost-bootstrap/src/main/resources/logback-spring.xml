<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 日志目录：数据目录下 logs/（《通用功能说明》§3）。
         跟随 bifrost.data.dir（容器里 BIFROST_DATA_DIR=/data → /data/logs），
         默认 ./data/logs 与历史行为一致；不能再用固定的 ${user.dir}，
         否则容器里日志落在卷外的 /app 下，容器重建即丢。 -->
    <springProperty scope="context" name="BIFROST_DATA_DIR" source="bifrost.data.dir" defaultValue="./data"/>
    <property name="LOG_DIR" value="${BIFROST_DATA_DIR}/logs"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/bifrost.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/bifrost.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 关键流程包日志级别可按需调整 -->
    <logger name="com.bifrost" level="INFO"/>
</configuration>
