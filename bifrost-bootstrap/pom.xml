<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bifrost</groupId>
        <artifactId>bifrost</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bifrost-bootstrap</artifactId>
    <name>bifrost-bootstrap</name>
    <description>Spring Boot 启动模块：启动类与 application.yml 配置</description>

    <dependencies>
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>bifrost-api</artifactId>
        </dependency>
        <!-- Subsonic 协议服务端（Syrinx）：/rest/** 控制器由 bootstrap 跨模块扫描注册 -->
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>subsonic-api</artifactId>
        </dependency>
        <!-- OPDS 1.2 协议发布（M2-book）：/opds/** 控制器由 bootstrap 跨模块扫描注册 -->
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>opds-publisher</artifactId>
        </dependency>
        <!-- KOSync 阅读进度同步协议（M3-sync）：/users/**、/syncs/**、/healthcheck 挂根路径 -->
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>kosync-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 显式声明持久化 Starter：JPA 运行时装配（实体/仓储来自 bifrost-domain，见《整体技术架构》§4） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 统一认证（ADR-0003）：SecurityConfig 双过滤器链（/api/** 与 /rest/**） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
