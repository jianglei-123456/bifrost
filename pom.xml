<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bifrost</groupId>
    <artifactId>bifrost</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>bifrost</name>
    <description>Bifrost - 家庭媒体库管理平台（视频 / 音频 / 电子书），统一 Spring Boot 版本与依赖版本</description>

    <modules>
        <module>bifrost-common</module>
        <module>bifrost-domain</module>
        <module>bifrost-core</module>
        <module>bifrost-adapter</module>
        <module>bifrost-api</module>
        <module>bifrost-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块统一版本管理 -->
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>bifrost-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>bifrost-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>bifrost-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>bifrost-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>syrinx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>subsonic-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>opds-publisher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bifrost</groupId>
                <artifactId>kosync-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- M2-book 外部依赖（中央仓库；版本经调研档核实） -->
            <dependency>
                <groupId>com.positiondev.epublib</groupId>
                <artifactId>epublib-core</artifactId>
                <version>3.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>3.0.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>xmpbox</artifactId>
                <version>3.0.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>1.13.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 所有模块统一引入 Lombok（编译期注解处理，不传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 所有模块统一测试基座（排除 slf4j-simple：与 bifrost-bootstrap 的 logback 冲突） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
