<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bifrost</groupId>
        <artifactId>bifrost</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>bifrost-domain</artifactId>
    <name>bifrost-domain</name>
    <description>核心实体（Entity）、DTO、枚举，以及数据库 Repository 接口</description>

    <dependencies>
        <dependency>
            <groupId>com.bifrost</groupId>
            <artifactId>bifrost-common</artifactId>
        </dependency>
        <!-- JPA 实体与 Spring Data Repository 接口（含 Hibernate 运行时），见《整体技术架构》§2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- SQLite 驱动与方言（BOM 管理版本），见《音乐管理技术设计》§2.1 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
    </dependencies>
</project>
